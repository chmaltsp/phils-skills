# Copy to .env and fill in. These back the ${...} placeholders in servers.template.json.
# .env is gitignored — never commit real values.

# postgres MCP — full Postgres connection string (includes the password)
POSTGRES_CONNECTION_STRING=postgres://user:password@host:5432/dbname

# posthog MCP — personal API key from PostHog → Settings → Personal API keys
POSTHOG_API_KEY=phx_your_key_here

# grafana MCP — your Grafana base URL + a service-account token
GRAFANA_URL=https://your-org.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_your_token_here

# linear MCP uses OAuth via mcp-remote (browser login on first run) — no key needed here.
# MCP_DOCKER (docker mcp gateway) needs Docker running — no key needed here.
